{
  "name": "@ymshenyu/nestjs-zod",
  "description": "Zod 4 class DTOs with native JSON Schema conversion for NestJS",
  "version": "0.0.0-set-by-ci",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dto": {
      "types": "./dist/dto.d.ts",
      "default": "./dist/dto.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymshenyu/nestjs-zod.git",
    "directory": "packages/nestjs-zod"
  },
  "author": "Ben Lorantfy <ben@lorantfy.com>",
  "contributors": [
    "Ben Lorantfy <ben@lorantfy.com>",
    "Evgeny Zakharov <to@risen.dev>"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:package": "node --test test/package-smoke.mjs",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "lint:fix": "oxlint --fix src test",
    "format:write": "oxfmt src test",
    "format:check": "oxfmt --check src test"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/testing": "^12.6.0",
    "@types/node": "^26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.1",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@nestjs/swagger": "^12.0.0",
    "zod": "^4.5.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
