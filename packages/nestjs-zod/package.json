{
  "name": "@ymshenyu/nestjs-zod",
  "description": "Zod 4 class DTOs with native JSON Schema conversion for NestJS",
  "version": "0.0.0-set-by-ci",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dto": {
      "import": {
        "types": "./dist/dto.d.mts",
        "default": "./dist/dto.mjs"
      },
      "require": {
        "types": "./dist/dto.d.cts",
        "default": "./dist/dto.cjs"
      }
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymshenyu/nestjs-zod.git",
    "directory": "packages/nestjs-zod"
  },
  "author": "Ben Lorantfy <ben@lorantfy.com>",
  "contributors": [
    "Ben Lorantfy <ben@lorantfy.com>",
    "Evgeny Zakharov <to@risen.dev>"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint  --fix",
    "format:write": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "tsdown": "^0.22.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "zod": "4.5.0",
    "@nestjs/platform-express": "^12.0.0",
    "vitest": "^4.1.12",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "zod": "^4.5.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
